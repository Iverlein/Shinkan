<?xml version="1.0" encoding="utf-8"?>
<!-- The beta also opens http from the host machine (10.0.2.2 on the emulator), for the
     browser's check of ROADMAP block 5; everything else as in the release. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- adb reverse tcp:8000 tcp:8000: the host's test page on the device's own loopback. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
