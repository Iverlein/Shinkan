<?xml version="1.0" encoding="utf-8"?>
<!-- INTERNET is for the filter (SPEC §5): Shinkan forwards the device's own DNS to the network's
     resolver. It has no endpoint of its own and sends nothing else (SPEC §2.1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The home screen lists the apps the child may use; a launcher needs to see the installed packages. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The hold is applied again after a reboot and at every window edge (SPEC §4.2). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The filter is a foreground service for as long as the device is held (SPEC §5.1). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shinkan">

        <!-- The child's home screen and the parent's door (SPEC §8). Offered as a launcher so that
             lock task mode can pin it (SPEC §4.1). -->
        <activity
            android:name="shinkan.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Block in Shinkan" on the share sheet (SPEC §6.2). -->
        <activity
            android:name="shinkan.app.filter.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Shinkan">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The device owner (SPEC §3). Named in the provisioning command:
             io.github.iverlein.shinkan/shinkan.app.admin.ShinkanAdmin -->
        <receiver
            android:name="shinkan.app.admin.ShinkanAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Applies the policy again after a reboot and at the next window edge (SPEC §4.2). -->
        <receiver
            android:name="shinkan.app.admin.ReapplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The filter (SPEC §5): the always-on VPN the device owner locks the device to. -->
        <service
            android:name="shinkan.app.filter.FilterService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Content filter: answers the device's DNS queries for as long as the device is held" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
