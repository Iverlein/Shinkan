<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission, by design (SPEC §2): Shinkan never sees the network. Content is
     controlled through the platform (SPEC §5.5), not through the app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The home screen lists the apps the child may use; a launcher needs to see the installed packages. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The hold is applied again after a reboot and at every window edge (SPEC §5.2). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shinkan">

        <!-- The child's home screen and the parent's door (SPEC §7). Offered as a launcher so that
             lock task mode can pin it (SPEC §5.1). -->
        <activity
            android:name="shinkan.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The device owner (SPEC §4). Named in the provisioning command:
             io.github.iverlein.shinkan/shinkan.app.admin.ShinkanAdmin -->
        <receiver
            android:name="shinkan.app.admin.ShinkanAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Applies the policy again after a reboot and at the next window edge (SPEC §5.2). -->
        <receiver
            android:name="shinkan.app.admin.ReapplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
